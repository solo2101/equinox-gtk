# Equinox Evolution Dusk, GTK2 controls theme for the original Equinox 1.50 engine.
# Copyright of the original engine belongs to its original authors.
gtk-color-scheme = "fg_color:#ededed\\nbg_color:#7a7a7a\\nbase_color:#dddddd\\ntext_color:#252525\\nselected_bg_color:#80b9d8\\nselected_fg_color:#202020"

style "equinox-evolution-dusk" {
  xthickness = 2
  ythickness = 2

  fg[NORMAL] = "#ededed"
  fg[ACTIVE] = "#ffffff"
  fg[PRELIGHT] = "#ffffff"
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = "#bbbbbb"

  bg[NORMAL] = "#7a7a7a"
  bg[ACTIVE] = "#696969"
  bg[PRELIGHT] = "#909090"
  bg[SELECTED] = "#80b9d8"
  bg[INSENSITIVE] = "#7a7a7a"

  base[NORMAL] = "#dddddd"
  base[ACTIVE] = "#bcbcbc"
  base[PRELIGHT] = "#eeeeee"
  base[SELECTED] = "#80b9d8"
  base[INSENSITIVE] = "#868686"

  text[NORMAL] = "#252525"
  text[ACTIVE] = "#252525"
  text[PRELIGHT] = "#252525"
  text[SELECTED] = "#202020"
  text[INSENSITIVE] = "#686868"

  engine "equinox" {
    contrast = 1.0
    curvature = 5.0
    menubarstyle = 1
    menubarborders = 1
    toolbarstyle = 1
    buttonstyle = 0
    menuitemstyle = 0
    scrollbarstyle = 1
    scrollbartrough = 0
    scalesliderstyle = 0
    checkradiostyle = 0
    progressbarstyle = 0
    separatorstyle = 1
    animation = TRUE
  }
}

class "*" style "equinox-evolution-dusk"
