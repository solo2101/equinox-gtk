# Equinox Evolution, GTK2 controls theme for the original Equinox 1.50 engine.
# Copyright of the original engine belongs to its original authors.
gtk-color-scheme = "fg_color:#252525\nbg_color:#d7d7d7\nbase_color:#ffffff\ntext_color:#252525\nselected_bg_color:#3978b4\nselected_fg_color:#ffffff"

style "equinox-evolution" {
  xthickness = 2
  ythickness = 2

  fg[NORMAL] = "#252525"
  fg[ACTIVE] = "#202020"
  fg[PRELIGHT] = "#161616"
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = "#686868"

  bg[NORMAL] = "#d7d7d7"
  bg[ACTIVE] = "#bcbcbc"
  bg[PRELIGHT] = "#e8e8e8"
  bg[SELECTED] = "#3978b4"
  bg[INSENSITIVE] = "#d7d7d7"

  base[NORMAL] = "#ffffff"
  base[ACTIVE] = "#e6e6e6"
  base[PRELIGHT] = "#ffffff"
  base[SELECTED] = "#3978b4"
  base[INSENSITIVE] = "#eeeeee"

  text[NORMAL] = "#252525"
  text[ACTIVE] = "#252525"
  text[PRELIGHT] = "#252525"
  text[SELECTED] = "#ffffff"
  text[INSENSITIVE] = "#686868"

  engine "equinox" {
    contrast = 1.0
    curvature = 5.0
    menubarstyle = 1
    menubarborders = 1
    toolbarstyle = 1
    buttonstyle = 0
    menuitemstyle = 0
    scrollbarstyle = 1
    scrollbartrough = 0
    scalesliderstyle = 0
    checkradiostyle = 0
    progressbarstyle = 0
    separatorstyle = 1
    animation = TRUE
  }
}

class "*" style "equinox-evolution"
