# Equinox Dark, GTK2 controls theme for the original Equinox 1.50 engine.
# Copyright of the original engine belongs to its original authors.
gtk-color-scheme = "fg_color:#e9e9e9\nbg_color:#333638\nbase_color:#25282a\ntext_color:#eeeeee\nselected_bg_color:#327ba9\nselected_fg_color:#ffffff"

style "equinox-dark" {
  xthickness = 2
  ythickness = 2

  fg[NORMAL] = "#e9e9e9"
  fg[ACTIVE] = "#ffffff"
  fg[PRELIGHT] = "#ffffff"
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = "#a8adaf"

  bg[NORMAL] = "#333638"
  bg[ACTIVE] = "#26292b"
  bg[PRELIGHT] = "#474b4e"
  bg[SELECTED] = "#327ba9"
  bg[INSENSITIVE] = "#333638"

  base[NORMAL] = "#25282a"
  base[ACTIVE] = "#303436"
  base[PRELIGHT] = "#35393b"
  base[SELECTED] = "#327ba9"
  base[INSENSITIVE] = "#303234"

  text[NORMAL] = "#eeeeee"
  text[ACTIVE] = "#ffffff"
  text[PRELIGHT] = "#ffffff"
  text[SELECTED] = "#ffffff"
  text[INSENSITIVE] = "#a8adaf"

  engine "equinox" {
    contrast = 1.0
    curvature = 5.0
    menubarstyle = 1
    menubarborders = 1
    toolbarstyle = 1
    buttonstyle = 0
    menuitemstyle = 0
    scrollbarstyle = 1
    scrollbartrough = 0
    scalesliderstyle = 0
    checkradiostyle = 0
    progressbarstyle = 0
    separatorstyle = 1
    animation = TRUE
  }
}

class "*" style "equinox-dark"
